# Enterprise Email IR Configuration

# Dataset settings
# DATASET_MODE can be 'demo' or 'full'
DATASET_MODE=demo
DEMO_EMAIL_LIMIT=10000

# File Paths (relative to project root or absolute)
DATA_DIR=data
DATABASE_PATH=data/processed/enron_emails.db
INDEX_DIR=data/indexes
MODEL_DIR=models
EVALUATION_DIR=data/evaluation
RESULTS_DIR=evaluation/results

# Model & Retrieval Settings
DENSE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_TOP_K=10
RRF_K=60
BM25_K1=1.5
BM25_B=0.75

# Field Weights for Combined Search Text
WEIGHT_SUBJECT=2.0
WEIGHT_BODY=1.0
WEIGHT_SENDER=0.5
WEIGHT_RECIPIENTS=0.5

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:5173
